PORT=3210
DATABASE_PATH=./data/rabbithole.sqlite
# JSON array. Generate each token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RABBITHOLE_USERS=[{"owner":"anshul","token":"REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"}]
PUBLIC_URL=http://localhost:3210
# Hosted single-owner alternative: have Render generate RABBITHOLE_TOKEN.
# RABBITHOLE_OWNER=anshul
# RABBITHOLE_TOKEN=generate-on-host-instead-of-uploading-local-credentials
# If RABBITHOLE_USERS is set, it takes precedence.
